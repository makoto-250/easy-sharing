# ---- 秘密情報（本番では必ず生成し直す。git管理外の .env に置く）----
# 生成: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# 共有キーのHMACダイジェスト用。変更すると既存の共有キーがすべて無効になる。
KEY_HMAC_SECRET=

# ---- 運用設定（仕様書 17章）----
SHARE_TTL_HOURS=12
MAX_TEXT_LENGTH=100000
MAX_FILE_BYTES=20971520
TOTAL_STORAGE_LIMIT=5368709120

# ---- 保存先（本番は Web 公開ディレクトリの外）----
UPLOAD_STORAGE_PATH=/var/lib/easy-sharing/uploads
DATABASE_PATH=/var/lib/easy-sharing/easy_sharing.db

# ---- 表示 ----
SERVICE_NAME=Easy Sharing

# 開発時のみ development にする（Secureクッキーを外し http で動く）
FLASK_ENV=production
